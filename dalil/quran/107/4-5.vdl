package soul.revelation.quran.107

revelation 4-5 {
    source "Al-Qur’an"
    surah "Al-Ma'un"
    locator "107:4-5"
    title "QS. Al-Ma'un [107]:4-5"
    numbering "Mushaf Uthmani (quran.com text_uthmani) / terjemahan Kemenag RI (resource 33)"
    sanad_status "verified"
    grade_status "Teks kanonik Al-Qur'an"
    original_text "فَوَيْلٌ لِّلْمُصَلِّينَ ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
    transliteration "Fa wailul lil-muṣallīn. Allażīna hum 'an ṣalātihim sāhūn."
    translation "Maka celakalah orang yang salat, (yaitu) orang-orang yang lalai terhadap salatnya,<sup foot_note=135878>1</sup>"
    body {
        > **Tafsir (Al-Tafsir al-Muyassar, ringkas):** Ancaman azab yang keras bagi orang-orang yang salat tetapi lalai terhadap salat mereka. Kelalaian itu dijelaskan sebagai tidak menegakkan salat sebagaimana mestinya. Mereka juga tidak menunaikannya pada waktunya.

        [Konteks pemakaian di dokumen: dirujuk pada peringatan kelalaian salat (bersama 29:45 dan 20:14); "heartbeat/synchronization" adalah analogi framework; kelalaian tidak boleh dipersempit hanya jadi kurang khusyuk.]
    }
}

audit_note sanad-4-5-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Teks kedua ayat diambil melalui dalil-fetch.py yang dijalankan
        auditor sendiri; terjemahan Kemenag RI (resource 33) dari
        verses/by_key 107:4 dan 107:5, Al-Tafsir al-Muyassar (resource 16)
        dari tafsirs/16/by_ayah 107:4 dan 107:5 (api.quran.com). Verdict
        AYAT_TERVERIFIKASI, konfidensi HIGH. Markup footnote dan koma akhir
        terjemahan dipertahankan verbatim. Catatan auditor: penyempitan makna
        di dist menjadi "tanpa kekhusyukan" saja tidak tepat — Al-Muyassar
        juga menyebut pelaksanaan yang semestinya dan ketepatan waktu.
    }
}
