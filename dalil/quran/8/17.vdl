package soul.revelation.quran.8

revelation 17 {
    source "Al-Qur’an"
    surah "Al-Anfal"
    locator "8:17"
    title "QS. Al-Anfal [8]:17"
    numbering "Mushaf Uthmani (quran.com text_uthmani) / terjemahan Kemenag RI (resource 33)"
    sanad_status "verified"
    grade_status "Teks kanonik Al-Qur'an"
    original_text "فَلَمْ تَقْتُلُوهُمْ وَلَـٰكِنَّ ٱللَّهَ قَتَلَهُمْ ۚ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَـٰكِنَّ ٱللَّهَ رَمَىٰ ۚ وَلِيُبْلِىَ ٱلْمُؤْمِنِينَ مِنْهُ بَلَآءً حَسَنًا ۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ"
    transliteration "Falam taqtulūhum wa lākinnallāha qatalahum, wa mā ramaita iż ramaita wa lākinnallāha ramā, wa liyubliyal-mu'minīna minhu balā'an ḥasanā, innallāha samī'un 'alīm."
    translation "Maka (sebenarnya) bukan kamu yang membunuh mereka, melainkan Allah yang membunuh mereka, dan bukan engkau yang melempar ketika engkau melempar, tetapi Allah yang melempar. (Allah berbuat demikian untuk membinasakan mereka) dan untuk memberi kemenangan kepada orang-orang mukmin, dengan kemenangan yang baik. Sungguh, Allah Maha Mendengar, Maha Mengetahui."
    body {
        > **Tafsir (Al-Tafsir al-Muyassar, ringkas):** Allah menolong orang-orang beriman menghadapi kaum musyrik pada hari Badar. Nabi melakukan lemparan, sedangkan Allah menyampaikan lemparan itu kepada wajah-wajah kaum musyrik. Melalui jihad, Allah menguji orang-orang beriman, mengangkat derajat mereka, dan memperkenalkan nikmat-Nya agar mereka bersyukur. Allah mendengar doa serta perkataan yang tersembunyi maupun terbuka dan mengetahui apa yang membawa kebaikan bagi hamba-Nya.

        [Konteks pemakaian di dokumen: dirujuk pada pembedaan tindakan dan penyampaian dampak di Badar; pemetaan ke node/Source/kasb adalah analogi atau sintesis framework.]
    }
}

audit_note sanad-17-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Teks Arab dari field text_uthmani Quran.com diambil melalui
        dalil-fetch.py yang dijalankan auditor sendiri; terjemahan Kemenag RI
        (resource 33) dan Al-Tafsir al-Muyassar (resource 16) dari api.quran.com
        (verses/by_key 8:17 + tafsirs/16/by_ayah/8:17). Verdict
        AYAT_TERVERIFIKASI, konfidensi HIGH. Konteks Badar disebut eksplisit
        dalam Al-Muyassar. Terjemahan di dist bukan verbatim resource 33;
        uraian kasb yang diatribusikan ke Ibnu Katsir belum diverifikasi di
        batch ini.
    }
}
