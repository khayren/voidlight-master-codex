package soul.revelation.quran.2

revelation 156 {
    source "Al-Qur’an"
    surah "Al-Baqarah"
    locator "2:156"
    title "QS. Al-Baqarah [2]:156"
    numbering "Mushaf Uthmani (quran.com text_uthmani) / terjemahan Kemenag RI (resource 33)"
    sanad_status "verified"
    grade_status "Teks kanonik Al-Qur'an"
    original_text "ٱلَّذِينَ إِذَآ أَصَـٰبَتْهُم مُّصِيبَةٌ قَالُوٓا۟ إِنَّا لِلَّهِ وَإِنَّآ إِلَيْهِ رَٰجِعُونَ"
    transliteration "Allażīna iżā aṣābathum muṣībatun qālū innā lillāhi wa innā ilaihi rāji'ūna."
    translation "(yaitu) orang-orang yang apabila ditimpa musibah, mereka berkata \"Innā lillāhi wa innā ilaihi rāji'ūn\" (sesungguhnya kami milik Allah dan kepada-Nyalah kami kembali)."
    body {
        > **Tafsir (Al-Tafsir al-Muyassar, ringkas):** Di antara sifat orang-orang yang sabar ialah bahwa ketika mengalami sesuatu yang tidak mereka sukai, mereka mengakui bahwa diri mereka adalah hamba milik Allah, berada dalam pengaturan dan ketetapan-Nya. Mereka juga mengakui akan kembali kepada-Nya melalui kematian, kemudian dibangkitkan untuk perhitungan dan pembalasan.

        [Konteks pemakaian di dokumen: ayat ini dipakai untuk konsep istirja dan transmutasi musibah; istilah "transmutasi" dan "redirect vs deny" adalah metafora penulis, bukan istilah ayat atau tafsir.]
    }
}

audit_note sanad-156-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Teks Arab dari field text_uthmani Quran.com; terjemahan Kemenag RI
        (resource 33) via Quran.com; tafsir ringkas dari Al-Tafsir al-Muyassar.
        Verdict AYAT_TERVERIFIKASI, konfidensi HIGH. Anomali tercatat: ayat
        dimulai allażīna (bukan innallażīna); bentuk aṣābathum, bukan
        "ash-shaba'uhum" seperti yang tertulis di konteks dokumen. Madani per
        metadata surah. Sumber: api.quran.com verse 2:156 + tafsirs/16.
    }
}
