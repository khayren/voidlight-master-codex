package soul.revelation.quran.29

revelation 45 {
    source "Al-Qur’an"
    surah "Al-Ankabut"
    locator "29:45"
    title "QS. Al-Ankabut [29]:45"
    numbering "Mushaf Uthmani (quran.com text_uthmani) / terjemahan Kemenag RI (resource 33)"
    sanad_status "verified"
    grade_status "Teks kanonik Al-Qur'an"
    original_text "ٱتْلُ مَآ أُوحِىَ إِلَيْكَ مِنَ ٱلْكِتَـٰبِ وَأَقِمِ ٱلصَّلَوٰةَ ۖ إِنَّ ٱلصَّلَوٰةَ تَنْهَىٰ عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۗ وَلَذِكْرُ ٱللَّهِ أَكْبَرُ ۗ وَٱللَّهُ يَعْلَمُ مَا تَصْنَعُونَ"
    transliteration "Utlu mā ūḥiya ilaika minal-kitābi wa aqimiṣ-ṣalāh, innaṣ-ṣalāta tanhā 'anil-faḥsyā'i wal-munkar, wa lażikrullāhi akbar, wallāhu ya'lamu mā taṣna'ūn."
    translation "Bacalah Kitab (Alquran) yang telah diwahyukan kepadamu (Muhammad) dan laksanakanlah salat. Sesungguhnya salat itu mencegah dari (perbuatan) keji dan mungkar. Dan (ketahuilah) mengingat Allah (salat) itu lebih besar (keutamaannya dari ibadah yang lain). Allah mengetahui apa yang kamu kerjakan."
    body {
        > **Tafsir (Al-Tafsir al-Muyassar, ringkas):** Ayat ini memerintahkan membaca dan mengamalkan Al-Qur'an serta menunaikan salat sesuai ketentuannya. Menjaga salat dengan menyempurnakan rukun dan syaratnya mencegah pelakunya dari maksiat dan kemungkaran, menerangi hati, menambah iman, serta menguatkan keinginan pada kebaikan dan mengurangi atau menghilangkan keinginan pada keburukan. Mengingat Allah dalam salat maupun di luar salat memiliki keutamaan yang sangat besar. Allah mengetahui segala kebaikan dan keburukan yang dilakukan dan memberikan balasan secara sempurna.

        [Konteks pemakaian di dokumen: dirujuk pada salat yang mencegah keji dan mungkar (bersama 107:4-5 dan 20:14); "daily alignment sync" dan "reset Qalb state" adalah analogi framework.]
    }
}

audit_note sanad-45-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Teks Arab dari field text_uthmani Quran.com diambil melalui
        dalil-fetch.py yang dijalankan auditor sendiri dan identik dengan raw
        JSON; terjemahan Kemenag RI (resource 33) dan Al-Tafsir al-Muyassar
        (resource 16) dari api.quran.com (verses/by_key 29:45 +
        tafsirs/16/by_ayah/29:45). Verdict AYAT_TERVERIFIKASI, konfidensi
        HIGH. Tidak ada anomali lafaz atau koordinat pada potongan ayat yang
        dipakai dist. Ayat pendamping 107:4-5 dan 20:14 tidak diaudit di
        batch ini.
    }
}
