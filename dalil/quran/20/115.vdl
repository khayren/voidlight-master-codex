package soul.revelation.quran.20

revelation 115 {
    source "Al-Qur’an"
    surah "Taha"
    locator "20:115"
    title "QS. Taha [20]:115"
    numbering "Mushaf Uthmani (quran.com text_uthmani) / terjemahan Kemenag RI (resource 33)"
    sanad_status "verified"
    grade_status "Teks kanonik Al-Qur'an"
    original_text "وَلَقَدْ عَهِدْنَآ إِلَىٰٓ ءَادَمَ مِن قَبْلُ فَنَسِىَ وَلَمْ نَجِدْ لَهُۥ عَزْمًا"
    transliteration "Wa laqad 'ahidnā ilā Ādama min qablu fa nasiya wa lam najid lahū 'azmā."
    translation "Dan sungguh telah Kami pesankan<sup foot_note=135477>1</sup> kepada Adam dahulu, tetapi dia lupa, dan Kami tidak dapati kemauan yang kuat padanya."
    body {
        > **Tafsir (Al-Tafsir al-Muyassar, ringkas):** Allah sebelumnya berpesan kepada Adam agar tidak memakan dari pohon tersebut. Allah juga memperingatkan bahwa Iblis adalah musuh Adam dan istrinya, agar tidak mengeluarkan keduanya dari surga sehingga mengalami kesusahan di dunia. Setan kemudian membisikkan godaan, lalu Adam menurutinya dan melupakan pesan itu. Tidak didapati padanya keteguhan tekad untuk menjaga perintah yang telah diberikan.

        [Konteks pemakaian di dokumen: dirujuk pada kelupaan Adam terhadap pesan yang diberikan; pengaitan pesan itu dengan record Mitsaq Alast dan "kelupaan runtime" adalah analogi atau sintesis framework yang memerlukan dalil tersendiri.]
    }
}

audit_note sanad-115-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Teks Arab dari field text_uthmani Quran.com diambil melalui
        dalil-fetch.py yang dijalankan auditor sendiri; terjemahan Kemenag RI
        (resource 33) dan Al-Tafsir al-Muyassar (resource 16) dari api.quran.com
        (verses/by_key 20:115 + tafsirs/16/by_ayah/20:115). Verdict
        AYAT_TERVERIFIKASI, konfidensi HIGH. Markup footnote HTML terjemahan
        dipertahankan verbatim. Catatan auditor: pesan yang dilupakan dalam
        Al-Muyassar berkaitan larangan memakan pohon dan peringatan Iblis,
        bukan identifikasi sebagai Mitsaq Alast; pengaitan itu bila hendak
        dipublikasikan sebagai kesimpulan teologis (termasuk soal keterjagaan
        para nabi) butuh ESKALASI_KE_MANUSIA.
    }
}
