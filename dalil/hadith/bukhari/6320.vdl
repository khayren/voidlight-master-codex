package soul.revelation.hadith.bukhari

revelation 6320 {
    source "HR. Bukhari"
    locator "no. 6320 (Kitab ad-Da'awat)"
    numbering "Referensi sunnah.com (edisi cetak Fuad Abdul Baqi belum dicek langsung)"
    narrator "Abu Hurairah"
    book_section "Kitab ad-Da'awat"
    grade_status "Shahih"
    grade_by "Imam Bukhari (dicantumkan dalam Shahih-nya)"
    sanad_status "verified"
    original_text "إِذَا أَوَى أَحَدُكُمْ إِلَى فِرَاشِهِ فَلْيَنْفُضْ فِرَاشَهُ بِدَاخِلَةِ إِزَارِهِ، فَإِنَّهُ لاَ يَدْرِي مَا خَلَفَهُ عَلَيْهِ، ثُمَّ يَقُولُ بِاسْمِكَ رَبِّ وَضَعْتُ جَنْبِي، وَبِكَ أَرْفَعُهُ، إِنْ أَمْسَكْتَ نَفْسِي فَارْحَمْهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ ‏\""
    transliteration "Idzā awā aḥadukum ilā firāsyihī fal-yanfuḍ firāsyahū bi-dākhilati izārihī, fa-innahū lā yadrī mā khalafahū 'alayhī, tsumma yaqūlu: Bismika Rabbi waḍa'tu jambī, wa bika arfa'uhū, in amsakta nafsī farḥamhā, wa in arsaltahā faḥfaẓhā bimā taḥfaẓu bihī 'ibādakaṣ-ṣāliḥīn."
    translation "Apabila salah seorang dari kalian hendak tidur, hendaklah ia mengibaskan tempat tidurnya dengan bagian dalam kainnya, karena ia tidak mengetahui apa yang berada di sana setelah ia tinggalkan. Kemudian ia mengucapkan: Dengan nama-Mu, Tuhanku, aku meletakkan sisiku dan dengan-Mu aku mengangkatnya. Jika Engkau menahan jiwaku, rahmatilah ia; jika Engkau melepaskannya, peliharalah ia dengan penjagaan yang Engkau berikan kepada hamba-hamba-Mu yang saleh."
    body {
        > **Isi hadits (ringkas):** Petunjuk mengibaskan tempat tidur sebelum tidur dan doa memohon rahmat bila jiwa ditahan serta penjagaan bila dilepaskan.

        [Konteks pemakaian di dokumen: doa tidur (bersama 2714a); hadits tidak menyebut perjalanan ruh ke barzakh; hubungan dengan metafora terminasi adalah analogi dokumen.]
    }
}

audit_note sanad-6320-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Matn Arab verbatim diambil melalui dalil-fetch.py yang dijalankan
        auditor sendiri dari sunnah.com/bukhari:6320. Nomor mengikuti referensi
        sunnah.com; edisi cetak Fuad Abdul Baqi belum dicek langsung. Grading
        individual tidak terlihat di fetch. Catatan: blok Inggris menyajikan
        doa sebagai transliterasi tanpa terjemahan, sehingga terjemahan
        Indonesia dikomposisikan auditor dari Arab dengan pemeriksaan silang.
        Verdict SAHIH_TERVERIFIKASI HIGH.
    }
}
