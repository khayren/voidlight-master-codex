package soul.revelation.hadith.bukhari

revelation 595 {
    source "HR. Bukhari"
    locator "no. 595 (Kitab Mawaqit as-Salat)"
    numbering "Referensi sunnah.com (edisi cetak Fuad Abdul Baqi belum dicek langsung)"
    narrator "Abu Qatadah (melalui putranya Abdullah bin Abi Qatadah)"
    book_section "Kitab Mawaqit as-Salat"
    grade_status "Shahih"
    grade_by "Imam Bukhari (dicantumkan dalam Shahih-nya)"
    sanad_status "verified"
    original_text "إِنَّ اللَّهَ قَبَضَ أَرْوَاحَكُمْ حِينَ شَاءَ، وَرَدَّهَا عَلَيْكُمْ حِينَ شَاءَ، يَا بِلاَلُ قُمْ فَأَذِّنْ بِالنَّاسِ بِالصَّلاَةِ ‏\"‏‏.‏ فَتَوَضَّأَ فَلَمَّا ارْتَفَعَتِ الشَّمْسُ وَابْيَاضَّتْ قَامَ فَصَلَّى‏.‏"
    transliteration "Innallāha qabaḍa arwāḥakum ḥīna syā'a, wa raddahā 'alaykum ḥīna syā'a, yā Bilālu qum fa-adzdzin bin-nāsi biṣ-ṣalāh. Fa-tawaḍḍa'a fa-lammā irtafa'atisy-syamsu wabyaḍḍat qāma fa-ṣallā."
    translation "Sesungguhnya Allah menahan ruh kalian saat Dia menghendaki, dan mengembalikannya kepada kalian saat Dia menghendaki. (Lalu beliau berkata:) Wahai Bilal, bangkitlah, umumkanlah azan kepada orang-orang untuk salat. Setelah matahari terbit dan terang, beliau bangkit dan menunaikan salat."
    body {
        > **Isi hadits (ringkas):** Rombongan tertidur hingga melewatkan salat Subuh; Nabi menjelaskan bahwa Allah menahan ruh mereka ketika menghendaki dan mengembalikannya ketika menghendaki, lalu memerintahkan azan dan salat.

        [Konteks pemakaian di dokumen: dirujuk pada tidur dan pengembalian ruh (bersama 39:42, 7471, 6320, 2714a); hadits tidak menetapkan rincian barzakh atau mekanisme alam gaib lain.]
    }
}

audit_note sanad-595-2026-11-15 {
    auditor "sanad-auditor"
    date "2026-11-15"
    body {
        Matn Arab verbatim diambil melalui dalil-fetch.py yang dijalankan
        auditor sendiri dari sunnah.com/bukhari:595. Nomor mengikuti referensi
        sunnah.com; edisi cetak Fuad Abdul Baqi belum dicek langsung. Grading
        individual tidak terlihat di fetch. Catatan: blok Arab ekstraksi hanya
        mencakup bagian akhir riwayat (lafaz ruh + azan), bukan seluruh
        narasi perjalanan yang ada di blok Inggris. Verdict SAHIH_TERVERIFIKASI
        HIGH.
    }
}
