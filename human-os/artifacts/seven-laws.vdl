package soul.human-os
import soul.human-os.seven-laws.*

artifact seven-laws {
    title "The Seven Laws of the OS"
    includes [
        autonomy, 
        interdependence, 
        meaning-before-scale, 
        structure-and-compassion, 
        discipline-before-intelligence, 
        creator-embedded, 
        endurance
    ]
    body {
        These are not suggestions. 
        They are structural constraints. 
        Break them, and the system degrades.
    }
}
