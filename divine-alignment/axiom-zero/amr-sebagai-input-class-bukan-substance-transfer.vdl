package soul.axiom-zero

artifact amr-sebagai-input-class-bukan-substance-transfer {
    title "Amr Sebagai Input Class, Bukan Substance Transfer"
    cites [
        soul.revelation.quran.17.85,
        soul.revelation.quran.36.82,
        soul.revelation.quran.32.7,
        soul.revelation.quran.30.30
    ]
    passages [
        soul.axiom-zero.amr-sebagai-input-class-bukan-substance-transfer.revelation-qs-al-isra-17-85,
        soul.axiom-zero.amr-sebagai-input-class-bukan-substance-transfer.revelation-qs-yasin-36-82,
        soul.axiom-zero.amr-sebagai-input-class-bukan-substance-transfer.synthesis-al-qur-an-konsisten-memisahkan-dua-register-proses-pen,
        prose {
            Firewall wajib di titik ini:

            > Node menerima Command (Ruh) dari Source (Alam al-Amr) **≠** Node terbuat dari Source / adalah bagian dari Source.

            Menerima input dari suatu Source tidak membuat penerima inherit status ontologis Source tersebut. Command bisa datang dari yang Wajibul Wujud, tapi penerima Command tetap Mumkinul Wujud — tidak ada transfer status lewat proses penerimaan.
        },
        soul.axiom-zero.amr-sebagai-input-class-bukan-substance-transfer.revelation-qs-as-sajdah-32-7,
        soul.axiom-zero.amr-sebagai-input-class-bukan-substance-transfer.analogy-kayak-thread-yang-menerima-signal-dari-kernel,
        prose {
            ---
        }
    ]
    body {
        > Rujukan v5.0.7: §0.3
    }
}
