package soul.alignment.agency-and-qadar.qadar-qada-branching-alignment-logic

artifact "soul.alignment.agency-and-qadar.qadar-qada-branching.only-way-in" {
    title "The Only Way In Is In"
    cites [soul.revelation.quran.26.88-89]
    passages [
        "soul.alignment.agency-and-qadar.qadar-qada-branching.only-way-in.synthesis-pencarian-vertikal-kepada-allah-dengan-horizontal-tool",
        prose {
            Horizontal tools (harta, jabatan, skill) bisa digunakan untuk *support* alignment — tapi tidak bisa *substitute* alignment. Orang kaya belum tentu aligned. Orang miskin belum tentu drifted.
        },
        "soul.alignment.agency-and-qadar.qadar-qada-branching.only-way-in.revelation-qs-asy-syu-ara-26-88-89",
        "soul.alignment.agency-and-qadar.qadar-qada-branching.only-way-in.revelation-ayat-ini-bukan-harta-itu-jahat"
    ]
    body {
        > Rujukan v5.0.7: §7.2
    }
}
