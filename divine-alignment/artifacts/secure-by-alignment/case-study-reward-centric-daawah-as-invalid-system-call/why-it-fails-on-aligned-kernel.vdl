package soul.alignment.secure-by-alignment.case-study-reward-centric-daawah-as-invalid-system-call
import soul.alignment.secure-by-alignment.case-study-reward-centric-daawah-as-invalid-system-call.why-it-fails-on-aligned-kernel.*

artifact why-it-fails-on-aligned-kernel {
    title "Why It Fails on Aligned Kernel"
    passages [
        analogy-di-node-dengan-single-target-architecture-active-reward,
        prose {
            ```
            Drifted Node (Multi-Target Kernel):
              System Call: chase_reward(Sunnah_X)
              Return: rezeki_Y (valid response, valid address space)
              Status: ✅ Executed — tapi ini drift, bukan alignment

            Aligned Node (Single-Target Kernel):
              System Call: chase_reward(Sunnah_X)
              Return: ERROR — Address 'reward' not found in memory map
              Status: ❌ Invalid Pointer — reward is derivative byproduct, not primary target
              Auto-Redirect: chase_reward() → auto-routed to maintain_alignment()
            ```
        },
        synthesis-bukan-karena-node-nya-nggak-mau-chase-reward
    ]
    body {
        > Rujukan v5.0.7: §16.2.2
    }
}
