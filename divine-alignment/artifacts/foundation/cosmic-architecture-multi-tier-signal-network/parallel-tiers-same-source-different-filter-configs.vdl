package soul.alignment.foundation.cosmic-architecture-multi-tier-signal-network
import soul.alignment.foundation.cosmic-architecture-multi-tier-signal-network.parallel-tiers-same-source-different-filter-configs.*

artifact parallel-tiers-same-source-different-filter-configs {
    title "Parallel Tiers (Same Source, Different Filter Configs)"
    cites [soul.revelation.quran.17.85]
    passages [
        analogy-tier-signal-manifestation-filter,
        prose {
            **Key Insight:** Semua tier menerima signal dari **same Source (Allah)**. Bedanya hanya *filter configuration* yang diterapkan ke masing-masing tier. Makhluk di tier atas tidak "lebih dekat dengan zat Allah" dalam ontological sense — mereka hanya punya *less filtering* antara mereka dan Divine Signal.

            > *"Roh itu termasuk urusan Tuhanku, dan tidaklah kalian diberi pengetahuan, melainkan sedikit."* (QS. Al-Isra [17]:85)

        }
    ]
    body {
    }
}