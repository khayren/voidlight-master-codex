package soul.alignment.foundation.entity-types-different-node-roles-in-alignment-network

artifact "soul.alignment.foundation.entity-types.malaikat-service" {
    title "Malaikat — Immutable Background Service"
    cites [soul.revelation.quran.66.6]
    passages [
        "soul.alignment.foundation.entity-types.malaikat-service.revelation-karakteristik-teologis-tidak-punya-free-will",
        prose {
            | Karakteristik                        | Arsitektural Equivalent                            |
            | ------------------------------------ | -------------------------------------------------- |
            | Tidak punya free will                | Hard-coded logic, no runtime parameter override    |
            | Selalu taat                          | Deterministic execution, zero deviation            |
            | Tidak diuji                          | Not a user node, a system service                  |
            | Meneruskan Command                   | Message broker / relay service                     |
            | Tidak punya nafs                     | No legacy firmware, no ego layer                   |
            | Network Firewall & Automatic Logging | IDS/IPS — monitor Dunya, log amal, block intrusion |
        },
        "soul.alignment.foundation.entity-types.malaikat-service.analogy-malaikat-adalah-infrastructure-service-kayak-dns",
        "soul.alignment.foundation.entity-types.malaikat-service.revelation-qs-at-tahrim-66-6-kutipan-dari-ayat"
    ]
    body {
        > Rujukan v5.0.7: §3.1
    }
}
