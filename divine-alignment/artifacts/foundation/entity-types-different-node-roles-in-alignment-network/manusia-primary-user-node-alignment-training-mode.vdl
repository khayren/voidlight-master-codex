package soul.alignment.foundation.entity-types-different-node-roles-in-alignment-network

artifact "soul.alignment.foundation.entity-types.manusia-user-node" {
    title "Manusia — Primary User Node (Alignment Training Mode)"
    cites [soul.revelation.quran.30.30]
    passages [
        "soul.alignment.foundation.entity-types.manusia-user-node.synthesis-karakteristik-arsitektural-equivalent",
        prose {
            Manusia adalah *primary kasb node* (per 0.6) — wujud mumkin (per 0.1) yang diberi kapasitas niyyah (per 0.7) untuk navigate ketergantungan eksistensialnya — satu-satunya entitas yang diberi kombinasi unik: (a) free will untuk memilih, (b) bio-vessel yang membatasi, (c) fitrah yang mengingatkan akan Source, dan (d) Qur'an sebagai alignment manual yang paling jelas.
        },
        "soul.alignment.foundation.entity-types.manusia-user-node.revelation-qs-ar-rum-30-30",
        "soul.alignment.foundation.entity-types.manusia-user-node.revelation-fitrah-adalah-default-alignment-configuration"
    ]
    body {
        > Rujukan v5.0.7: §3.3
    }
}
